# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pesight
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email codes (password reset, two-step sign-in, email verification) via https://www.brevo.com.
# Leave empty while developing: the codes are then printed in the backend terminal.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Pesight

# Google sign-in: the Web client ID from Google Cloud (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
